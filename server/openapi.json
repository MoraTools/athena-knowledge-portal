{
  "openapi": "3.0.3",
  "info": {
    "title": "Athena management API",
    "version": "1.3.0",
    "description": "Private knowledge base. Create a scoped key in /admin/athena/apikey/. Keys expire after 90 days by default and are revoked when the owning user is disabled, removed, or has their password reset. Browser cookies are not accepted by the API. Guide for agents: GET /api/docs/. Check a key with GET /me/."
  },
  "servers": [
    {
      "url": "https://athena.moratechnology.com/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/": {
      "servers": [
        {
          "url": "https://athena.moratechnology.com/api/v1"
        },
        {
          "url": "https://athena.moratechnology.com/api"
        }
      ],
      "get": {
        "operationId": "api_index",
        "summary": "API index",
        "security": [],
        "description": "Served at /api/ and /api/v1/. Lists every route with its methods. No key needed.",
        "responses": {
          "200": {
            "description": "JSON {name, version, docs, openapi, auth, endpoints}"
          }
        }
      }
    },
    "/me/": {
      "get": {
        "operationId": "read_me",
        "summary": "Check the current key",
        "description": "Returns the key owner, the key, and a can map: read_articles, write_articles, manage_downloads, manage_users.",
        "responses": {
          "200": {
            "description": "JSON {user, key, can}"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          }
        }
      }
    },
    "/articles/": {
      "get": {
        "operationId": "list_articles",
        "summary": "List articles",
        "responses": {
          "200": {
            "description": "JSON {count, offset, limit, results}. Default limit 50, maximum 100."
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "post": {
        "operationId": "create_articles",
        "summary": "Create article",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArticleInput"
              }
            }
          }
        }
      }
    },
    "/articles/{slug}/": {
      "get": {
        "operationId": "get_article",
        "summary": "Get article",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "ETag": {
                "description": "Version for If-Match on updates and deletes.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "patch": {
        "operationId": "update_article",
        "summary": "Update article",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact ETag returned by the latest GET, including double quotes. Prevents overwriting newer changes."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArticleInput"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "delete_article",
        "summary": "Delete article",
        "responses": {
          "204": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact ETag returned by the latest GET, including double quotes. Prevents overwriting newer changes."
          }
        ]
      }
    },
    "/downloads/": {
      "get": {
        "operationId": "list_downloads",
        "summary": "List downloads",
        "description": "Read scope lists published files; keys with the articles or admin scope and download permissions also see hidden files.",
        "responses": {
          "200": {
            "description": "JSON {results}: slug, title, section, filename, size, sha256, note, published, created_at, url (signed-in browser download)."
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        }
      },
      "post": {
        "operationId": "upload_download",
        "summary": "Upload a download (articles or admin scope)",
        "responses": {
          "201": {
            "description": "The created download."
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "section",
                  "file"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "section": {
                    "type": "string",
                    "enum": [
                      "framework",
                      "packages",
                      "exercises",
                      "previous"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Up to 512 MB through the proxy. The original file name is kept."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/downloads/{slug}/": {
      "delete": {
        "operationId": "delete_download",
        "summary": "Delete a download and its file (articles or admin scope)",
        "responses": {
          "204": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/users/": {
      "get": {
        "operationId": "list_users",
        "summary": "List users",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "description": "Requires admin scope and a superuser account."
      },
      "post": {
        "operationId": "create_users",
        "summary": "Create user",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        },
        "description": "Requires admin scope and a superuser account."
      }
    },
    "/users/{user_id}/": {
      "get": {
        "operationId": "get_user",
        "summary": "Get user",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "patch": {
        "operationId": "update_user",
        "summary": "Update user",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "delete_user",
        "summary": "Delete user",
        "responses": {
          "204": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/articles/{slug}/pdf/": {
      "post": {
        "operationId": "upload_pdf",
        "summary": "Attach PDF (25 MiB) or replace Markdown (1 MiB)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact ETag returned by the latest GET, including double quotes. Prevents overwriting newer changes."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "download_pdf",
        "summary": "Download an article PDF",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/articles/{slug}/markdown/": {
      "post": {
        "operationId": "upload_markdown",
        "summary": "Attach PDF (25 MiB) or replace Markdown (1 MiB)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid, expired, or revoked key"
          },
          "403": {
            "description": "Insufficient scope or user permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "412": {
            "description": "Missing or stale If-Match"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact ETag returned by the latest GET, including double quotes. Prevents overwriting newer changes."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/docs/": {
      "servers": [
        {
          "url": "https://athena.moratechnology.com/api"
        }
      ],
      "get": {
        "operationId": "api_docs",
        "summary": "API guide (Markdown)",
        "security": [],
        "description": "Served at /api/docs/. No key needed.",
        "responses": {
          "200": {
            "description": "API.md as text/markdown",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ArticleInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "Markdown, at most 1 MiB. Required unless the article already has a PDF."
          },
          "status": {
            "type": "string",
            "enum": [
              "",
              "stable",
              "alpha",
              "coming-soon"
            ]
          },
          "url": {
            "type": "string"
          },
          "download_file": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "page",
              "guide",
              "tool",
              "announcement",
              "release"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "published": {
            "type": "boolean",
            "default": false
          },
          "pdf_only": {
            "type": "boolean",
            "default": false,
            "description": "The attached PDF is the whole article; the reader offers no Exportar PDF button."
          }
        }
      },
      "UserInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 12
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "admin": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

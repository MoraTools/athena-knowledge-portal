    "/article-images/": {
      "post": {
        "operationId": "upload_article_image",
        "summary": "Stage a private article image",
        "description": "Requires articles or admin scope and add_article or change_article. Validates PNG/JPEG/WebP/GIF up to 10 MiB and 20 million pixels. GIF can be static or animated, with at most 2000 frames and 2000 million processed pixels (canvas width × height × frame count). Reduce frame count or resolution if the limits are exceeded. Animated PNG/WebP and unsupported GIF rendering extensions are rejected. PNG/JPEG/WebP are re-encoded; GIF image blocks, timing, transparency, disposal, and loop settings are preserved. Every GIF frame is decoded in sequence by a separate worker limited to 10 CPU seconds, 12 elapsed seconds, and 512 MiB of memory. Comments, other application metadata, and data after the trailer are removed. PDF exports use the first GIF frame. Does not change an article or its ETag. Paste the returned markdown into an article body, then use the normal article create/PATCH or Markdown upload endpoint. An unattached image is visible only to its uploader while the uploader can still edit articles.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Validated image metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleImage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid file or request fields"
          },
          "401": {
            "description": "Invalid bearer key"
          },
          "403": {
            "description": "Insufficient scope or article permissions"
          }
        }
      }
    },
    "/article-images/{id}/": {
      "get": {
        "operationId": "read_article_image",
        "summary": "Read an article image with a bearer key",
        "description": "Read keys see images in published articles. Article editors with articles/admin keys can read draft images. Only the uploader with an edit-capable key can preview an unattached image. The returned url uses browser session/public article access; it does not accept bearer keys.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG/JPEG/WebP/GIF bytes. Animated GIFs retain all frames.",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/gif": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Invalid bearer key"
          },
          "404": {
            "description": "Missing image or no readable reference"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ArticleInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "Markdown, at most 1 MiB. Required unless the article already has a PDF."
          },
          "status": {
            "type": "string",
            "enum": [
              "",
              "stable",
              "alpha",
              "coming-soon"
            ]
          },
          "url": {
            "type": "string"
          },
          "download_file": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "page",
              "guide",
              "tool",
              "announcement",
              "release"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "published": {
            "type": "boolean",
            "default": false
          },
          "pdf_only": {
            "type": "boolean",
            "default": false,
            "description": "The attached PDF is the whole article; the reader offers no Exportar PDF button."
          },
          "is_public": {
            "type": "boolean",
            "default": false,
            "description": "Allow anonymous reading of the published article, its images, attached PDFs, and generated PDF exports. Drafts stay restricted. Existing API authentication and edit permissions still apply."
          }
        }
      },
      "UserInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 12
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "admin": {

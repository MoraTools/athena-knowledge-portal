[Unit]
Description=Remove unused Athena article images

[Service]
Type=oneshot
User=athena
Group=athena
WorkingDirectory=/opt/athena/server
EnvironmentFile=/etc/athena/athena.env
ExecStart=/opt/athena/.venv/bin/python manage.py collect_article_images
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/athena

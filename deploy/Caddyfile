athena.moratechnology.com {
    # Download and video uploads (admin form, editor, API) may be large; everything else keeps the small limit.
    @big path /admin/* /api/* /article-images/upload/
    @small not path /admin/* /api/* /article-images/upload/
    request_body @big {
        max_size 512MB
    }
    request_body @small {
        max_size 27MB
    }
    handle_path /static/* {
        root * /opt/athena/staticfiles
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
    # The default encode types leave video/* and images other than SVG uncompressed, so byte ranges stay exact.
    encode zstd gzip
}

http://159.203.121.42 {
    handle /healthz {
        respond "Athena is running. Use https://athena.moratechnology.com to sign in." 200
    }
    handle {
        redir https://athena.moratechnology.com{uri} permanent
    }
}

# Other sites on this droplet (for example aisolutions-demo) install their own file here. No match is not an error.
import /etc/caddy/conf.d/*.caddy
